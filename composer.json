{
    "name": "fingerprintphp/fingerprintphp",
    "description": "PHP wrapper for FingerprintJS browser fingerprinting library",
    "keywords": ["fingerprint", "browser", "tracking", "visitor", "identification"],
    "license": "MIT",
    "authors": [
        {
            "name": "Olakunlevpn",
            "email": "maylancerit@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Fingerprintphp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fingerprintphp\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
